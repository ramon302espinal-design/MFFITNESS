<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="ModoPrueba" value="false" />
    <add key="TwilioWhatsAppEnabled" value="true" />
    <!-- true = recordatorios mientras la UI esta abierta (respaldo si el Host no corre).
         Host 24/7 sigue siendo el preferido fuera de horario; NotificacionYaEnviada evita duplicados. -->
    <add key="TwilioTimerUIHabilitado" value="true" />
    <add key="TwilioModoProduccion" value="true" />
    <add key="DiasRecordatorioDeuda" value="5" />
    <add key="DiasRecordatorioMembresia" value="10" />
    <add key="DiasRecordatorioMembresiaUrgente" value="3" />
    <add key="IntervaloAutomatizacionMinutos" value="15" />
    <add key="TwilioMaxReintentosMensajes" value="5" />
    <add key="TwilioMaxIntentosPorMensaje" value="3" />
    <!-- Credenciales: NO poner AuthToken/ApiKeySecret aquí. Usar
         %LocalAppData%\MFFITNESS\twilio.secrets.config (ver twilio.secrets.config.example)
         o env TWILIO_ACCOUNT_SID / TWILIO_API_KEY_SID / TWILIO_API_KEY_SECRET -->
    <add key="TwilioAccountSid" value="" />
    <add key="TwilioAuthToken" value="" />
    <!-- WhatsApp Business (ya en uso por facturas) -->
    <add key="TwilioPhoneNumber" value="+14247284594" />
    <!-- Opcional: SMS/MMS y voz (si vacio usan TwilioPhoneNumber) -->
    <add key="TwilioSmsPhoneNumber" value="" />
    <add key="TwilioVoicePhoneNumber" value="" />
    <!-- URL https TwiML para llamadas (TwiML Bin o webhook). Obligatoria para voz. -->
    <add key="TwilioVoiceTwimlUrl" value="" />
    <!-- Plantilla general aprobada en Meta (una variable {{1}}).
         Texto: Hola! Estimado cliente de Mf Fitness: {{1}} Para mas informacion
         o asistencia, comuniquese con la recepcion de Mf Fitness. -->
    <add key="TwilioContentSidGenerico" value="HXe2f17ada69a083d5cb1442b25b58bc1f" />
    <!-- Vacía para usar exclusivamente TwilioContentSidGenerico aprobado con {{1}}. -->
    <add key="TwilioContentSidAvisoUtility" value="HX3c04a72dcdf65920c00d9540b5b45f29;HX5a5dc2db221582a8e5df6c3229994cca" />
    <!-- Plantilla twilio/media aprobada (PDF adjunto). Vacío = usa link o adjunto libre 24h.
         Crear con: Tools\WhatsAppHost\Create-FacturaMediaTemplate.ps1 -->
    <add key="TwilioContentSidFactura" value="HXcba3de80d13c8a80f0a3a3282bb06ece" />
    <add key="TwilioContentVariableKey" value="1" />
    <add key="TwilioExigirEntregaConfirmada" value="true" />
    <!-- true = intenta PDF como archivo (ventana 24h). Con TwilioContentSidFactura no hace falta. -->
    <add key="TwilioPermitirBodyEnProduccion" value="true" />
    <add key="WhatsAppAdjuntarPdfLibre" value="true" />
    <add key="TwilioIntentosConsultaEstado" value="3" />
    <add key="TwilioMilisegundosEntreConsultasEstado" value="500" />
    <!-- Supabase Storage (produccion). Key en %LocalAppData%\MFFITNESS\supabase.secrets.config -->
    <add key="SupabaseStorageEnabled" value="true" />
    <add key="SupabaseUrl" value="https://xirmhjqtjltgzidnsmjt.supabase.co" />
    <add key="SupabaseBucketFacturas" value="FACTURAS" />
    <!-- Fallback solo si Supabase no esta configurado: Kestrel local + URL HTTPS publica -->
    <add key="WhatsAppMediaListenUrl" value="http://127.0.0.1:5088" />
    <!-- HTTPS publico (Ngrok/cloudflared). Twilio webhook: {base}/webhook/twilio/whatsapp -->
    <add key="WhatsAppPublicBaseUrl" value="" />
    <add key="TwilioWebhookInboundPath" value="/webhook/twilio/whatsapp" />
    <add key="TwilioWebhookValidarFirma" value="true" />
    <!-- Chat manual: false = solo recepción (sin enviar desde FrmChat). -->
    <add key="ChatEnvioManualHabilitado" value="false" />
  </appSettings>
</configuration>
<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- Requerido por el diseñador WinForms (VS: "No se puede recuperar el GUID del proyecto") -->
		<ProjectGuid>{5B286F5E-1DA4-C61D-7861-80C46E44F0B3}</ProjectGuid>
		<RootNamespace>UI</RootNamespace>
		<!-- Nombre del ejecutable (UI.exe): requerido por el contrato OTA. -->
		<AssemblyName>UI</AssemblyName>

		<!-- Icono embebido en el .exe (Explorador / acceso directo). -->
		<ApplicationIcon>Resources\mf.ico</ApplicationIcon>

		<!-- Metadatos comerciales (Propiedades del archivo en Windows). -->
		<AssemblyTitle>MFFITNESS</AssemblyTitle>
		<Product>MFFITNESS</Product>
		<Company>MFFITNESS</Company>
		<Authors>MFFITNESS</Authors>
		<Description>MFFITNESS POS — sistema de gestión para gimnasios</Description>
		<Copyright>Copyright © MFFITNESS</Copyright>
		<NeutralLanguage>es-DO</NeutralLanguage>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\BLL\BLL.csproj" />
		<ProjectReference Include="..\CORE\CORE.csproj" />
		<ProjectReference Include="..\MODELS\DTO.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- Copia mf.ico a output\Resources\ para carga dinámica segura en formularios. -->
		<None Update="Resources\mf.ico">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Resources\mf_logo.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="Resources\nav_back.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<Content Include="..\Database\Migrations\*.sql">
			<Link>Database\Migrations\%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>


<?xml version="1.0" encoding="utf-8" ?>
<!--
  Copiar a: %LocalAppData%\MFFITNESS\twilio.secrets.config
  Preferido: API Key (ya usada por MFFITNESS).
  Env alternativas:
    TWILIO_ACCOUNT_SID, TWILIO_API_KEY_SID, TWILIO_API_KEY_SECRET
    o TWILIO_AUTH_TOKEN
  No versionar valores reales.
-->
<appSettings>
  <add key="TwilioAccountSid" value="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" />
  <add key="TwilioApiKeySid" value="SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" />
  <add key="TwilioApiKeySecret" value="PEGAR_API_KEY_SECRET_AQUI" />
  <!-- Alternativa: -->
  <!-- <add key="TwilioAuthToken" value="PEGAR_AUTH_TOKEN_AQUI" /> -->
</appSettings>
